# Normalize line endings for text files.
* text=auto

# Source and documentation
*.h         text diff=cpp
*.hpp       text diff=cpp
*.cpp       text diff=cpp
*.cmake     text
CMakeLists.txt text
*.cs        text diff=csharp
*.py        text diff=python
*.toml      text
*.txt       text
*.md        text diff=markdown
*.json      text
*.yml       text
*.yaml      text
*.sh        text eol=lf

# Unity YAML assets (the project uses Force Text serialization).
# Optional: enable Unity Smart Merge locally, see
# https://docs.unity3d.com/Manual/SmartMerge.html
*.unity           text
*.prefab          text
*.asset           text
*.mat             text
*.meta            text
*.anim            text
*.controller      text
*.overrideController text
*.physicMaterial  text
*.mask            text
*.playable        text
*.shadergraph     text
*.shadersubgraph  text
*.inputactions    text
*.uxml            text
*.uss             text
*.asmdef          text
*.asmref          text
*.shader          text
*.hlsl            text
*.cginc           text

# NAIF text kernels (PCK, LSK, FK) are text.
*.tpc       text
*.tls       text
*.tf        text

# Binary files are stored with Git LFS (see docs/adr/0005). Contributors need `git lfs install`.
# Raw kernels, data packs and native plugin binaries are normally ignored (reproducible); the
# rules below only matter if one is ever committed deliberately.

# Images and textures
*.png       filter=lfs diff=lfs merge=lfs -text
*.jpg       filter=lfs diff=lfs merge=lfs -text
*.jpeg      filter=lfs diff=lfs merge=lfs -text
*.tga       filter=lfs diff=lfs merge=lfs -text
*.tif       filter=lfs diff=lfs merge=lfs -text
*.tiff      filter=lfs diff=lfs merge=lfs -text
*.psd       filter=lfs diff=lfs merge=lfs -text
*.exr       filter=lfs diff=lfs merge=lfs -text
*.hdr       filter=lfs diff=lfs merge=lfs -text
*.ktx       filter=lfs diff=lfs merge=lfs -text
*.ktx2      filter=lfs diff=lfs merge=lfs -text

# Models
*.fbx       filter=lfs diff=lfs merge=lfs -text
*.blend     filter=lfs diff=lfs merge=lfs -text
*.glb       filter=lfs diff=lfs merge=lfs -text

# Audio and video
*.wav       filter=lfs diff=lfs merge=lfs -text
*.mp3       filter=lfs diff=lfs merge=lfs -text
*.ogg       filter=lfs diff=lfs merge=lfs -text
*.mp4       filter=lfs diff=lfs merge=lfs -text
*.mov       filter=lfs diff=lfs merge=lfs -text

# Fonts and documents
*.ttf       filter=lfs diff=lfs merge=lfs -text
*.otf       filter=lfs diff=lfs merge=lfs -text
*.pdf       filter=lfs diff=lfs merge=lfs -text

# Native binaries
*.dll       filter=lfs diff=lfs merge=lfs -text
*.so        filter=lfs diff=lfs merge=lfs -text
*.dylib     filter=lfs diff=lfs merge=lfs -text
*.a         filter=lfs diff=lfs merge=lfs -text
*.lib       filter=lfs diff=lfs merge=lfs -text

# Data (binary kernels and data packs)
*.bsp       filter=lfs diff=lfs merge=lfs -text
*.bpc       filter=lfs diff=lfs merge=lfs -text
*.bin       filter=lfs diff=lfs merge=lfs -text
*.uspack    filter=lfs diff=lfs merge=lfs -text
