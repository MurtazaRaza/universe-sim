root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{h,hpp,cpp}]
max_line_length = 110

[*.cs]
max_line_length = 120

[*.py]
max_line_length = 100

# Unity asmdef/asmref files keep the editor's 4-space indentation (the default above).
[*.{json,yml,yaml}]
indent_size = 2

[CMakeLists.txt]
indent_size = 4

[*.md]
trim_trailing_whitespace = false

# Unity-serialized assets are written by the editor; do not reformat them.
[UniverseSim/{Assets,ProjectSettings,Packages}/**.{unity,prefab,asset,mat,meta,anim,controller}]
indent_size = unset
trim_trailing_whitespace = unset
insert_final_newline = unset
