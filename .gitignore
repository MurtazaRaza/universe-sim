# Root ignore rules for the whole repository.
# Unity-specific rules live in UniverseSim/.gitignore (patterns there are rooted at the Unity project).

# OS
.DS_Store
Thumbs.db
Desktop.ini

# IDEs and editors
.idea/
.vs/
.vscode/
*.user
*.suo
*.swp

# C++ build output (CMake presets write to core/build/<preset>/)
/core/build/
CMakeUserPresets.json
compile_commands.json
.cache/

# Python (tools/pipeline)
__pycache__/
*.pyc
.venv/
.pytest_cache/

# Data: raw downloads and generated packs are reproducible from data/sources.lock.json.
# See docs/adr/0005-data-provenance-and-storage.md. The default pack is the exception: it is committed
# through Git LFS (docs/adr/0006-default-pack-window-and-storage.md).
/data/raw/
/data/packs/*
!/data/packs/solar-system-*.uspack
*.part
